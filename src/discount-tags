// Which rows are sales: the name says sale, or it's Natasha's Birthday (a
// store-wide birthday sale) or Shopping IL (Israel's shopping-festival sale).
const SALE_NAME_RE = /\bsale\b|birthday|shopping\s*il/i;
const BUNDLE_NAME_RE = /bundle|\bsets?\b|סטים/i;

function classify(rows, source) {
  const sales = [], bundles = [], all = [];
  for (const [rawName, rawTag] of rows) {
    const name = String(rawName || '').trim(), tag = String(rawTag || '').trim();
    if (!name || !tag || /^discount name$/i.test(name)) continue;
    all.push({ name, tag });
    if (SALE_NAME_RE.test(name)) sales.push({ name, tag });
    else if (BUNDLE_NAME_RE.test(name)) bundles.push({ name, tag });
  }
  return { sales, bundles, all, source };
}

const cache = new Map(); // site -> { at, value }
async function fetchDiscountTags(site) {
  if (!TAB_GID[site]) return null;
  const hit = cache.get(site);
  if (hit && Date.now() - hit.at < CACHE_MS) return hit.value;
  let value = null;
  try {
    const url = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/export?format=csv&gid=${TAB_GID[site]}`;
    const res = await fetch(url, { signal: AbortSignal.timeout(30000) });
    const text = res.ok ? await res.text() : '';
    const head = text.slice(0, 200).trimStart().toLowerCase();
    if (res.ok && text && !head.startsWith('<!doctype') && !head.startsWith('<html')) {
      const rows = parseCsv(text).map((r) => [r[0], r[1]]);
      const v = classify(rows, 'sheet');
      if (v.all.length) value = v;
    } else {
      console.error(`discount-tags: sheet not readable for site=${site} (${res.status}) — share "Evergreen Discounts Tags" as "Anyone with the link — Viewer"; using the built-in copy`);
    }
  } catch (err) {
    console.error(`discount-tags: fetch failed for site=${site}: ${err.message} — using the built-in copy`);
  }
  if (!value) value = classify(FALLBACK[site], 'built-in');
  // Cache a fallback for 10 minutes only, so sharing the sheet takes effect soon.
  cache.set(site, { at: value.source === 'sheet' ? Date.now() : Date.now() - CACHE_MS + 10 * 60 * 1000, value });
  return value;
}

module.exports = { fetchDiscountTags, classify, FALLBACK };
