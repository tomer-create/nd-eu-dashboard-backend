# Copy this file's variable NAMES into Render's dashboard for this service
# (Settings > Environment), one store block per site you've set up a
# Shopify Dev Dashboard custom app for. Do NOT commit a real .env file —
# it's already in .gitignore.

# Shopify Admin API version to call. Bump this every few months as Shopify
# releases new quarterly versions; old ones eventually stop being supported.
SHOPIFY_API_VERSION=2026-07

# --- ND.COM (natashadenona.myshopify.com) ---
SHOPIFY_COM_DOMAIN=natashadenona.myshopify.com
SHOPIFY_COM_CLIENT_ID=
SHOPIFY_COM_CLIENT_SECRET=

# --- ND.EU (natasha-denona-trading.myshopify.com) ---
SHOPIFY_EU_DOMAIN=natasha-denona-trading.myshopify.com
SHOPIFY_EU_CLIENT_ID=
SHOPIFY_EU_CLIENT_SECRET=

# --- ND.IL (natashadenona-il.myshopify.com) ---
SHOPIFY_IL_DOMAIN=natashadenona-il.myshopify.com
SHOPIFY_IL_CLIENT_ID=
SHOPIFY_IL_CLIENT_SECRET=

# Comma-separated list of origins allowed to call this API from a browser
# (the dashboard's URL). Use "*" while testing, lock it down once you know
# the dashboard's real origin.
ALLOWED_ORIGINS=*

PORT=3000
